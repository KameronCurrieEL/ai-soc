# Copy to .env and edit. .env is gitignored; never commit real values.

# Ollama (runs on Windows). Leave OLLAMA_URL empty to auto-detect the
# Windows host via the WSL default gateway (it changes after reboots).
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_AGENT_MODEL=...
OLLAMA_PORT=11434

# Wazuh manager API (Phase 1+). Lab defaults from wazuh-docker; change for anything non-local.
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
# TLS verification (run `make wazuh-certs` first). The API cert is self-signed -> pinned;
# the indexer cert is signed by the Wazuh root CA and issued to the name "wazuh.indexer".
WAZUH_VERIFY_TLS=true
WAZUH_API_CA_FILE=infra/certs/wazuh-api.pem
WAZUH_INDEXER_CA_FILE=infra/certs/root-ca.pem
WAZUH_INDEXER_TLS_NAME=wazuh.indexer

# Wazuh indexer (OpenSearch, Phase 3+): where alerts are stored. Lab default admin user.
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
